# ─────────────────────────────────────────────────────────────────────────────
# Local development secrets for `wrangler dev`
# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Worker secrets (set in production with `wrangler secret put <NAME>`)
# are NOT available locally. Copy this file to `.dev.vars` and fill in the values
# so `npm start` can run against real key material:
#
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is git-ignored — never commit real secrets. Use dotenv syntax:
# one KEY="value" per line, with JSON values kept on a single line.
# See https://hexdocs.pm/dotenvy/dotenv-file-format.html

# ─────────────────────────────────────────────────────────────────────────────
# Required: single backend config secret
# ─────────────────────────────────────────────────────────────────────────────
# Paste the full contents of `approov-config.json` (from
# `approov secret -getBackendConfig approov-config.json`) on one line, or
# generate the line with:
#   printf "APPROOV_BACKEND_CONFIG='%s'\n" "$(jq -c . approov-config.json)"
# This populates the default/pass/fail JWKS, API assignments, ARC encoding
# secret, and ARC flag mappings.
# The `apis` map must contain the hostname you send local requests to; the
# README shows how to reach the registered gateway hostname on localhost.
APPROOV_BACKEND_CONFIG='{"currentArcEncodingSecret":"...","pendingArcEncodingSecret":null,"previousArcEncodingSecrets":[],"defaultPassJWKS":{"keys":[{"kty":"oct","use":"sig","alg":"HS256","kid":"_HS256","k":"..."}]},"passJWKS":{"keys":[]},"failJWKS":{"keys":[]},"arcFlagMappings":{"1":"debug","2":"scan-fail"},"apis":{"approov-gateway.example.workers.dev":{"kid":"example-es256","isPassKeyPresent":true,"isFailKeyPresent":true}}}'

# Enable only while accepting/migrating APIs that use the default account secret.
APPROOV_ACCEPT_DEFAULT_ACCOUNT_SECRET="false"

# ─────────────────────────────────────────────────────────────────────────────
# Account message signing (needed when a trusted token has mskid)
# ─────────────────────────────────────────────────────────────────────────────
# First add APPROOV_ACCOUNT_MESSAGE_SIGNING_SECRET to [secrets].required in
# wrangler.toml; Wrangler then loads this optional secret from .dev.vars.
# APPROOV_ACCOUNT_MESSAGE_SIGNING_SECRET="<account-signing-secret>"
# APPROOV_ACCOUNT_MESSAGE_SIGNING_KEY_ID="<expected-mskid>"

# Match setStatusHeader when the service layer uses a custom header name.
# APPROOV_STATUS_HEADER_NAME="Approov-Status"

# Safe analytics (non-secret settings; dataset binding belongs in wrangler.toml).
# APPROOV_ANALYTICS_ENABLED="true"
# APPROOV_LOGGING_ENABLED="true"
