{
  "name": "approov-worker",
  "version": "0.0.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.0",
    "@vitest/coverage-istanbul": "~4.1.12",
    "esbuild": "0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "structured-headers": "1.0.1",
    "vitest": "~4.1.12",
    "wrangler": "^4.110.0"
  },
  "private": true,
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.6"
    }
  },
  "scripts": {
    "start": "node scripts/wrangler.mjs dev --port 8787",
    "deploy": "node scripts/wrangler.mjs deploy",
    "generate:plugins": "node scripts/generate-plugins.mjs",
    "pretest": "node scripts/generate-plugins.mjs",
    "test": "npx vitest run --coverage",
    "test:nocov": "npx vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "lint": "npx eslint . --ext .js,.mjs",
    "audit": "node scripts/audit.mjs",
    "test:audit": "node --test test/audit.test.mjs",
    "build:vendor": "node scripts/build-message-signatures.mjs",
    "check:vendor": "node scripts/build-message-signatures.mjs --check",
    "validate:config": "node scripts/validate-config.js",
    "versions:upload": "node scripts/wrangler.mjs versions upload",
    "test:preflight": "node --test test/preflight.test.mjs"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
